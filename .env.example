# ---- RaktSetu environment variables ----
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env

# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/raktsetu
# Atlas example:  mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/raktsetu
MONGO_CONNECTION_URL=mongodb://127.0.0.1:27017/raktsetu

# Secret used to sign session cookies. Use a long random string.
COOKIE_SECRET=replace-with-a-long-random-string

# Port the server listens on (optional, defaults to 3000).
PORT=3000
