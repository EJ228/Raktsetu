<div class="min-h-screen grid md:grid-cols-2 bg-white">
    <!-- Left: form -->
    <div class="px-6 md:px-16 py-10 md:py-14 flex flex-col items-center justify-center">
        <div class="w-full max-w-md">
            <a href="/"
                class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#6B7280] hover:text-ink mb-6">
                <%- include('../partials/icon', { name: 'arrow-left' , size: 14 }) %>
                    Back to home
            </a>
            <%- include('../partials/logo') %>

                <h1 class="mt-10 font-bold text-ink tracking-tight"
                    style="font-size:clamp(28px,3.5vw,36px);letter-spacing:-0.025em;line-height:1.1;">Welcome back.</h1>
                <p class="mt-3 text-[15px] text-[#6B7280]">Sign in to manage your donations, requests and inventory.</p>

                <form action="/login" method="POST" class="mt-8 flex flex-col gap-4">
                    <label class="flex flex-col gap-1.5">
                        <span class="text-[13px] font-medium text-ink">Email <span
                                class="text-[#C8232C]">*</span></span>
                        <div
                            class="flex items-center gap-2 h-11 rounded-[10px] border border-[#E5E7EB] bg-white px-3.5 focus-within:border-ink">
                            <%- include('../partials/icon', { name: 'mail' , size: 16, className: 'text-[#9CA3AF]' }) %>
                                <input name="email" type="email" required placeholder="you@email.com"
                                    class="flex-1 bg-transparent text-[14px] outline-none" />
                        </div>
                    </label>

                    <label class="flex flex-col gap-1.5">
                        <span class="text-[13px] font-medium text-ink">Password <span
                                class="text-[#C8232C]">*</span></span>
                        <div
                            class="flex items-center gap-2 h-11 rounded-[10px] border border-[#E5E7EB] bg-white px-3.5 focus-within:border-ink">
                            <%- include('../partials/icon', { name: 'shield-check' , size: 16,
                                className: 'text-[#9CA3AF]' }) %>
                                <input name="password" type="password" required placeholder="••••••••"
                                    class="flex-1 bg-transparent text-[14px] outline-none" />
                        </div>
                    </label>

                    <div class="flex items-center justify-between mt-1">
                        <label class="flex items-center gap-2 text-[13px] text-[#6B7280] cursor-pointer">
                            <input type="checkbox" name="remember" class="rounded border-[#E5E7EB]" />
                            Keep me signed in
                        </label>
                        <a href="#" class="text-[13px] font-semibold text-[#C8232C] hover:underline">Forgot
                            password?</a>
                    </div>

                    <button type="submit"
                        class="rs-btn-primary h-[52px] rounded-[10px] mt-2 font-semibold text-[15px] inline-flex items-center justify-center gap-2">
                        Sign in
                        <%- include('../partials/icon', { name: 'arrow-right' , size: 18 }) %>
                    </button>
                </form>

                <div class="mt-6 flex items-center gap-3">
                    <div class="flex-1 h-px bg-[#E5E7EB]"></div>
                    <span class="text-[12px] text-[#9CA3AF] uppercase font-medium">or</span>
                    <div class="flex-1 h-px bg-[#E5E7EB]"></div>
                </div>

                <button disabled
                    class="mt-4 w-full h-[48px] rounded-[10px] border border-[#E5E7EB] bg-white text-ink font-semibold text-[14px] inline-flex items-center justify-center gap-2 hover:bg-[#FAFAFA] opacity-60 cursor-not-allowed">
                    Sign in with one-time code via SMS
                </button>

                <p class="mt-6 text-[14px] text-[#6B7280] text-center">
                    New to RaktSetu? <a href="/register" class="font-semibold text-ink hover:underline">Create an
                        account</a>
                </p>

                <details class="mt-6 text-[12.5px] text-[#6B7280]">
                    <summary class="cursor-pointer font-semibold text-ink">▶ Demo logins</summary>
                    <div class="mt-3 grid gap-2 bg-[#FAFAFA] p-3 rounded-[10px] font-mono">
                        <div><span class="text-[#9CA3AF]">donor</span> · rohan@example.com / password123</div>
                        <div><span class="text-[#9CA3AF]">requester</span> · rahul@example.com / password123</div>
                        <div><span class="text-[#9CA3AF]">bank admin</span> · rashmi@gmc.in / password123</div>
                    </div>
                </details>

                <div class="mt-8 pt-6 border-t border-[#E5E7EB] text-center text-[12px] text-[#9CA3AF]">
                    © 2026 RaktSetu Foundation &nbsp;·&nbsp;
                    <a href="#" class="hover:text-ink">Privacy</a> &nbsp;·&nbsp;
                    <a href="#" class="hover:text-ink">Terms</a> &nbsp;·&nbsp;
                    <a href="#" class="hover:text-ink">Help</a>
                </div>
        </div>
    </div>

    <!-- Right: artwork pane -->
    <div class="hidden md:block relative" style="background:#FAFAFA;">
        <div class="absolute inset-0 rs-map-bg opacity-50"></div>
        <div class="relative h-full flex flex-col justify-center px-12 lg:px-16 py-14">
            <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">Today, across
                India</span>
            <h2 class="mt-3 font-bold text-ink tracking-tight"
                style="font-size:36px;letter-spacing:-0.025em;line-height:1.1;">
                412 donors have already<br />said yes today.
            </h2>
            <p class="mt-4 text-[15px] text-[#6B7280] max-w-[420px] leading-[1.6]">
                A live snapshot of pledges accepted in the last 24 hours, by blood group.
            </p>
            <div class="mt-10 grid gap-3 max-w-[420px]">
                <% [{g:'O+',c:412},{g:'A+',c:318},{g:'B+',c:274},{g:'O-',c:96},{g:'AB+',c:88},{g:'A-',c:71},{g:'B-',c:54},{g:'AB-',c:22}].forEach(function(row){
                    %>
                    <div class="flex items-center gap-4">
                        <%- include('../partials/bloodBadge', { group: row.g, size: 'md' , variant: 'ghost' }) %>
                            <div class="flex-1 h-7 rounded-md bg-white border border-[#E5E7EB] overflow-hidden">
                                <div class="h-full rounded-md"
                                    style="width:<%= Math.round(row.c / 412 * 100) %>%;background:#C8232C;"></div>
                            </div>
                            <div class="text-[13px] font-semibold tabular-nums text-ink w-10 text-right">
                                <%= row.c %>
                            </div>
                    </div>
                    <% }); %>
            </div>

            <!-- Fulfilled story card -->
            <div class="mt-8 bg-white rounded-[12px] border border-[#E5E7EB] px-4 py-3 flex items-start gap-3 max-w-[420px]"
                style="box-shadow:0 2px 8px rgba(0,0,0,0.04);">
                <div class="h-8 w-8 rounded-full bg-[#D1FAE5] grid place-items-center text-[#065F46] shrink-0 mt-0.5">
                    <%- include('../partials/icon', { name: 'check-circle' , size: 14 }) %>
                </div>
                <div>
                    <div class="text-[11px] font-bold text-[#065F46] uppercase">Fulfilled · <span
                            class="font-normal text-[#6B7280]">4 minutes ago</span></div>
                    <p class="text-[13px] text-ink mt-0.5">Vihaan, B+, donated at Apollo Hospitals, Bengaluru. 1 unit
                        secured for an accident patient.</p>
                </div>
            </div>
        </div>
    </div>
</div>