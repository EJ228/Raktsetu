<%- include('../partials/appShellStart', { active: 'dashboard', shellTitle: user.name.split(' ')[0] + ', your help is needed nearby.', shellSubtitle: 'Donor dashboard' }) %>

<div class="grid gap-6">
    <!-- Eligibility Card -->
    <div class="rounded-[16px] overflow-hidden p-6 md:p-8" style="background: linear-gradient(135deg,#FAFAFA 0%, #FFFFFF 100%);border:1px solid #E5E7EB;box-shadow:0 1px 2px rgba(16,24,40,0.04);">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
            <div class="h-16 w-16 rounded-full grid place-items-center shrink-0" style="background:<%= eligibility.eligible ? '#D1FAE5' : '#FEF3C7' %>;color:<%= eligibility.eligible ? '#065F46' : '#92400E' %>;">
                <%- include('../partials/icon', { name: eligibility.eligible ? 'check-circle' : 'clock', size: 28, stroke: 2.4 }) %>
            </div>
            <div class="flex-1">
                <span class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color:<%= eligibility.eligible ? '#065F46' : '#92400E' %>;">
                    Eligibility · <%= eligibility.eligible ? 'Cleared' : 'On cooldown' %>
                </span>
                <h2 class="mt-1.5 font-bold text-ink tracking-tight" style="font-size:24px;letter-spacing:-0.02em;">
                    <%= eligibility.eligible ? "You're eligible to donate today." : 'Next eligible in ' + eligibility.daysUntilEligible + ' days.' %>
                </h2>
                <p class="text-[14px] text-[#6B7280] mt-2 max-w-[520px]"><%= eligibility.lastDonationLabel || eligibility.reason %></p>
            </div>
            <div class="flex flex-col items-start md:items-end gap-3 shrink-0">
                <div class="flex items-center gap-3">
                    <% if (user.bloodGroup) { %><%- include('../partials/bloodBadge', { group: user.bloodGroup, size: 'lg' }) %><% } %>
                    <div class="text-right">
                        <div class="text-[11px] uppercase tracking-[0.12em] text-[#9CA3AF] font-semibold">Your group</div>
                        <div class="text-[13px] font-semibold text-ink"><%= tagline || '—' %></div>
                    </div>
                </div>
                <a href="/donor/profile" class="rs-btn-primary h-10 px-4 rounded-[10px] font-semibold text-[13px] inline-flex items-center gap-2">
                    <%- include('../partials/icon', { name: 'edit', size: 14 }) %>
                    Edit profile
                </a>
            </div>
        </div>
    </div>

    <!-- Impact KPIs -->
    <div class="grid md:grid-cols-3 gap-4">
        <%- include('../partials/kpiCard', { icon: 'droplet', value: pledges.length.toString(), label: 'Lifetime donations', subLabel: '≈ ' + (pledges.length * 450) + ' ml whole blood given' }) %>
        <%- include('../partials/kpiCard', { icon: 'heart',   value: (pledges.length * 3).toString(),   label: 'Lives potentially impacted', subLabel: 'Each unit can help up to 3 patients', tone: 'success' }) %>
        <%- include('../partials/kpiCard', { icon: 'map-pin', value: urgent.length.toString(),   label: 'Compatible matches nearby', subLabel: user.city || 'In your city', tone: 'info' }) %>
    </div>

    <!-- Main + sidebar -->
    <div class="grid md:grid-cols-12 gap-6">
        <section class="md:col-span-8">
            <div class="flex items-end justify-between mb-4">
                <div>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">Real-time · <%= urgent.length %> compatible matches</span>
                    <h2 class="mt-1 font-semibold text-ink tracking-tight" style="font-size:18px;letter-spacing:-0.015em;">Urgent requests near you</h2>
                </div>
            </div>

            <div class="grid gap-3">
                <% if (urgent.length === 0) { %>
                    <%- include('../partials/emptyState', {
                        context: 'DONOR · NEARBY',
                        icon: 'map-pin',
                        tone: 'gray',
                        title: 'No active requests in 10 km',
                        desc: 'You\'re in a quiet window. We\'ll alert you the moment a critical match shows up within your radius — meanwhile, you can pre-pledge for the next match.',
                        primaryBtn: { text: 'Widen to 25 km', href: '#', icon: 'sliders' },
                        secondaryBtn: { text: 'Pre-pledge', href: '#' }
                    }) %>
                <% } %>

                <% urgent.forEach(function(r){ %>
                    <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-5 hover:border-ink/25 transition-colors">
                        <div class="flex items-start gap-4">
                            <div class="shrink-0 flex flex-col items-center">
                                <%- include('../partials/bloodBadge', { group: r.bloodGroup, size: 'lg' }) %>
                                <div class="mt-2 text-[11px] text-[#9CA3AF] font-medium"><%= r.unitsNeeded %>u needed</div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                                    <%- include('../partials/urgencyBadge', { level: r.urgency }) %>
                                    <span class="text-[11px] text-[#9CA3AF]">posted <%= moment(r.createdAt).fromNow() %></span>
                                </div>
                                <h4 class="text-[15px] font-semibold text-ink leading-snug">
                                    <%= r.unitsNeeded %> unit<%= r.unitsNeeded > 1 ? 's' : '' %> of <%= r.bloodGroup %> at <%= r.bloodBankId ? r.bloodBankId.name : 'a partner bank' %>
                                </h4>
                                <p class="text-[13px] text-[#6B7280] mt-1 leading-snug"><%= r.condition || 'Patient needs ' + r.component.replace('_', ' ') %></p>
                                <div class="mt-3 flex items-center gap-3 flex-wrap text-[12px] text-[#6B7280]">
                                    <span class="inline-flex items-center gap-1">
                                        <%- include('../partials/icon', { name: 'map-pin', size: 12 }) %>
                                        <%= r.bloodBankId ? r.bloodBankId.city : r.city %>
                                    </span>
                                    <span>·</span>
                                    <span class="inline-flex items-center gap-1">
                                        <%- include('../partials/icon', { name: 'clock', size: 12 }) %>
                                        Needed by <%= moment(r.neededBy).fromNow() %>
                                    </span>
                                </div>
                            </div>
                            <div class="shrink-0 hidden md:flex flex-col gap-2 items-end">
                                <a href="/donor/requests/<%= r._id %>" class="rs-btn-primary h-10 px-4 rounded-[10px] font-semibold text-[13px] inline-flex items-center gap-2">View & pledge</a>
                            </div>
                        </div>
                        <div class="md:hidden mt-4">
                            <a href="/donor/requests/<%= r._id %>" class="rs-btn-primary h-10 rounded-[10px] font-semibold text-[13px] inline-flex items-center justify-center w-full">View & pledge</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <aside class="md:col-span-4 flex flex-col gap-6">
            <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-5">
                <div class="flex items-end justify-between mb-4">
                    <h2 class="font-semibold text-ink tracking-tight" style="font-size:18px;">Donation history</h2>
                </div>
                <% if (pledges.length === 0) { %>
                    <div class="py-6">
                        <div class="mx-auto h-12 w-12 rounded-full bg-[#FCE9EA] grid place-items-center text-[#C8232C] mb-4">
                            <%- include('../partials/icon', { name: 'droplet', size: 20 }) %>
                        </div>
                        <div class="text-[10px] font-bold uppercase tracking-[0.15em] text-[#9CA3AF] mb-1.5 text-center">
                            DONOR · HISTORY
                        </div>
                        <h3 class="text-[15px] font-bold text-ink tracking-tight mb-2 text-center leading-tight">
                            Your story starts with one donation
                        </h3>
                        <p class="text-[12.5px] text-[#6B7280] leading-relaxed mb-5 text-center">
                            No donations on file yet. Find a centre near you and we'll guide you through eligibility, the visit, and your first certificate.
                        </p>
                        <div class="flex flex-col gap-2">
                            <a href="/search" class="rs-btn-primary h-10 rounded-[8px] font-semibold text-[13px] inline-flex items-center justify-center gap-2">
                                <%- include('../partials/icon', { name: 'map-pin', size: 14 }) %>
                                Find a centre
                            </a>
                            <a href="#" class="h-10 rounded-[8px] border border-[#E5E7EB] text-ink font-semibold text-[13px] inline-flex items-center justify-center hover:bg-[#FAFAFA]">
                                Am I eligible?
                            </a>
                        </div>
                    </div>
                <% } else { pledges.forEach(function(p) { %>
                    <div class="flex items-center gap-3 py-3 border-b border-[#E5E7EB] last:border-0">
                        <div class="h-10 w-10 rounded-full bg-[#FCE9EA] grid place-items-center shrink-0 text-[#C8232C]">
                            <%- include('../partials/icon', { name: 'droplet', size: 14 }) %>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-[13px] font-semibold text-ink truncate"><%= p.bankId ? p.bankId.name : 'Blood bank' %></div>
                            <div class="text-[11.5px] text-[#6B7280]"><%= moment(p.updatedAt).format('DD MMM YYYY') %> · 1 unit</div>
                        </div>
                    </div>
                <% }); } %>
            </div>

            <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-5">
                <h2 class="font-semibold text-ink tracking-tight mb-3" style="font-size:18px;">Donor streak</h2>
                <div class="grid grid-cols-7 gap-1.5 mb-3">
                    <% for (var i = 0; i < 42; i++) { var active = pledges.length > i / 8; %>
                        <div class="aspect-square rounded-[4px]" style="background:<%= active ? '#C8232C' : '#F3F4F6' %>;opacity:<%= active ? (0.4 + (i % 5) * 0.15) : 1 %>;"></div>
                    <% } %>
                </div>
                <p class="text-[12px] text-[#6B7280] leading-[1.55]">
                    <% if (pledges.length === 0) { %>
                        Pledge to your first urgent request to start your donor streak.
                    <% } else { %>
                        You've donated <strong class="text-ink"><%= pledges.length %> times</strong>. Keep it up.
                    <% } %>
                </p>
            </div>
        </aside>
    </div>
</div>

<%- include('../partials/appShellEnd') %>
