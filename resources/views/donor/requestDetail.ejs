<%- include('../partials/appShellStart', { active: 'dashboard', shellTitle: r.unitsNeeded + ' unit(s) of ' + r.bloodGroup + ' at ' + (r.bloodBankId.name), shellSubtitle: 'Request · posted ' + moment(r.createdAt).fromNow() }) %>

<div class="grid md:grid-cols-12 gap-6 pb-20 md:pb-0" data-request-id="<%= r._id %>">
    <div class="md:col-span-8 grid gap-6">

        <!-- Hero -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-6 md:p-7">
            <div class="flex items-start gap-5">
                <%- include('../partials/bloodBadge', { group: r.bloodGroup, size: 'xl' }) %>
                <div class="flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <%- include('../partials/urgencyBadge', { level: r.urgency }) %>
                        <%- include('../partials/statusBadge', { status: r.status }) %>
                        <span class="text-[11px] text-[#9CA3AF]">posted <%= moment(r.createdAt).fromNow() %></span>
                    </div>
                    <h1 class="font-bold text-ink tracking-tight mt-2.5" style="font-size:clamp(22px,3vw,30px);letter-spacing:-0.025em;line-height:1.15;">
                        Patient needs <%= r.unitsNeeded %> unit<%= r.unitsNeeded > 1 ? 's' : '' %> by <%= moment(r.neededBy).format('DD MMM, h:mm A') %>
                    </h1>
                    <p class="text-[14px] text-[#6B7280] mt-2.5 leading-[1.6] max-w-[560px]">
                        <%= r.patientGender === 'male' ? 'A' : 'A' %> <%= r.patientAge %>-year-old <%= r.patientGender %> patient <%= r.condition ? '(' + r.condition + ')' : '' %>. The bank has <%= r.unitsFulfilled %> of <%= r.unitsNeeded %> units secured so far.
                    </p>

                    <% if (!myPledge) { %>
                        <form action="/donor/requests/<%= r._id %>/pledge" method="POST" class="mt-5 flex gap-3 flex-wrap">
                            <button type="submit" class="rs-btn-primary h-[52px] px-6 rounded-[10px] font-semibold text-[15px] inline-flex items-center gap-2">
                                <%- include('../partials/icon', { name: 'droplet', size: 18 }) %>
                                I can donate
                            </button>
                            <button type="button" class="h-[52px] px-6 rounded-[10px] bg-white border border-[#E5E7EB] text-ink font-semibold text-[15px] inline-flex items-center gap-2 hover:bg-[#FAFAFA]">
                                <%- include('../partials/icon', { name: 'share', size: 18 }) %>
                                Share request
                            </button>
                        </form>
                    <% } else { %>
                        <div class="mt-5 inline-flex items-center gap-3 px-4 h-12 rounded-[10px] bg-[#D1FAE5] text-[#065F46]">
                            <%- include('../partials/icon', { name: 'check-circle', size: 18 }) %>
                            <span class="font-semibold text-[14px]">You've pledged. The blood bank will reach out shortly.</span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Compatibility callout -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-5 border-l-4" style="border-left-color:<%= compatible ? '#10B981' : '#F59E0B' %>;">
            <div class="flex items-start gap-4">
                <div class="h-10 w-10 rounded-full grid place-items-center shrink-0" style="background:<%= compatible ? '#D1FAE5' : '#FEF3C7' %>;color:<%= compatible ? '#10B981' : '#92400E' %>;">
                    <%- include('../partials/icon', { name: compatible ? 'check-circle' : 'shield-check', size: 18 }) %>
                </div>
                <div class="flex-1">
                    <div class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color:<%= compatible ? '#065F46' : '#92400E' %>;">
                        <%= compatible ? 'Compatibility confirmed' : 'Compatibility check' %>
                    </div>
                    <h4 class="text-[15px] font-semibold text-ink mt-0.5">
                        <% if (compatible && user.bloodGroup) { %>
                            Your <%= user.bloodGroup %> blood is compatible with this <%= r.bloodGroup %> recipient.
                        <% } else { %>
                            Your blood group is not directly compatible with this recipient.
                        <% } %>
                    </h4>
                    <p class="text-[12.5px] text-[#6B7280] mt-1.5 leading-[1.55]">
                        The blood bank will run a final cross-match before any transfusion.
                    </p>
                    <% if (user.bloodGroup) { %>
                        <div class="mt-3 flex items-center gap-2">
                            <%- include('../partials/bloodBadge', { group: user.bloodGroup, size: 'sm' }) %>
                            <%- include('../partials/icon', { name: 'arrow-right', size: 14, className: 'text-[#9CA3AF]' }) %>
                            <%- include('../partials/bloodBadge', { group: r.bloodGroup, size: 'sm', variant: 'ghost' }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Request summary -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-6">
            <div class="flex items-end justify-between mb-4">
                <div>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">Request · #RS-<%= String(r._id).slice(-5).toUpperCase() %></span>
                    <h2 class="mt-1 font-semibold text-ink tracking-tight" style="font-size:18px;">What's needed</h2>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-x-8 gap-y-4">
                <% [
                    ['Blood group needed', r.bloodGroup],
                    ['Units needed', r.unitsNeeded + ' unit' + (r.unitsNeeded > 1 ? 's' : '')],
                    ['Component', r.component.replace('_', ' ')],
                    ['Needed by', moment(r.neededBy).format('DD MMM, h:mm A')],
                    ['Patient', 'Anonymised · ' + r.patientAge + 'y / ' + r.patientGender],
                    ['Condition', r.condition || '—'],
                ].forEach(function(row){ %>
                    <div class="flex items-center justify-between gap-4">
                        <span class="text-[12.5px] text-[#6B7280]"><%= row[0] %></span>
                        <span class="font-semibold text-ink text-[14px] capitalize"><%= row[1] %></span>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- What happens next -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-6">
            <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">What happens next</span>
            <h2 class="mt-1 font-semibold text-ink tracking-tight" style="font-size:18px;">Four small steps</h2>
            <div class="mt-5 grid gap-4">
                <% [
                    { n: 1, title: 'Pledge here on RaktSetu', sub: '1-tap, lets the bank know to expect you.', active: true },
                    { n: 2, title: 'Carry a govt. ID & your donor card', sub: 'Aadhaar or PAN works. Donor card is on your profile.' },
                    { n: 3, title: 'Reach the bank by ' + moment(r.neededBy).format('h:mm A') + ' today', sub: 'The patient is scheduled for transfusion at ' + moment(r.neededBy).format('h A') + '.' },
                    { n: 4, title: 'Donation takes ~ 30 minutes', sub: "You'll be observed for 10 mins after. Drink water." },
                ].forEach(function(step){ %>
                    <div class="flex items-start gap-4">
                        <span class="h-8 w-8 rounded-full grid place-items-center text-[13px] font-bold shrink-0 <%= step.active ? 'bg-[#C8232C] text-white' : 'bg-[#F3F4F6] text-[#6B7280]' %>"><%= step.n %></span>
                        <div>
                            <div class="text-[14px] font-semibold text-ink"><%= step.title %></div>
                            <div class="text-[12.5px] text-[#6B7280] mt-0.5"><%= step.sub %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <aside class="md:col-span-4 grid gap-6">
        <!-- Bank card -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-6">
            <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">Where to go</span>
            <h2 class="mt-1 mb-4 font-semibold text-ink tracking-tight" style="font-size:18px;"><%= r.bloodBankId.name %></h2>
            <div class="flex items-start gap-3">
                <div class="h-11 w-11 rounded-[10px] bg-[#FAFAFA] grid place-items-center shrink-0">
                    <%- include('../partials/icon', { name: 'hospital', size: 18 }) %>
                </div>
                <div class="flex-1">
                    <div class="text-[14px] font-semibold text-ink"><%= r.bloodBankId.address %></div>
                    <div class="text-[12.5px] text-[#6B7280] mt-0.5"><%= r.bloodBankId.city %></div>
                    <div class="text-[12px] text-[#6B7280] mt-2 flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center gap-1">
                            <span class="h-1.5 w-1.5 rounded-full bg-[#10B981]"></span> <%= r.bloodBankId.openHours %>
                        </span>
                        <% if (r.bloodBankId.phone) { %>
                            <span>·</span><span class="inline-flex items-center gap-1"><%- include('../partials/icon', { name: 'phone', size: 12 }) %> <%= r.bloodBankId.phone %></span>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-2">
                <% if (r.bloodBankId.phone) { %>
                    <a href="tel:<%= r.bloodBankId.phone %>" class="h-10 rounded-[8px] border border-[#E5E7EB] font-semibold text-[12.5px] inline-flex items-center justify-center gap-1.5 hover:bg-[#FAFAFA]">
                        <%- include('../partials/icon', { name: 'phone', size: 13 }) %> Call bank
                    </a>
                <% } %>
                <a href="https://maps.google.com/?q=<%= encodeURIComponent(r.bloodBankId.address + ', ' + r.bloodBankId.city) %>" target="_blank" class="h-10 rounded-[8px] border border-[#E5E7EB] font-semibold text-[12.5px] inline-flex items-center justify-center gap-1.5 hover:bg-[#FAFAFA]">
                    <%- include('../partials/icon', { name: 'map', size: 13 }) %> Open in Maps
                </a>
            </div>
        </div>

        <!-- Other donors -->
        <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-6">
            <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280]">Others responding</span>
            <h2 class="mt-1 mb-4 font-semibold text-ink tracking-tight" style="font-size:18px;">
                <%= otherPledges.length %> donor<%= otherPledges.length === 1 ? '' : 's' %> have pledged
            </h2>
            <% if (otherPledges.length === 0) { %>
                <p class="text-[13px] text-[#6B7280]">Be the first to respond — every minute counts.</p>
            <% } else { otherPledges.forEach(function(p){ %>
                <div class="flex items-center gap-3 py-2 border-b border-[#E5E7EB] last:border-0">
                    <%- include('../partials/avatar', { name: p.donorId.name, size: 36 }) %>
                    <div class="flex-1 min-w-0">
                        <div class="text-[13.5px] font-semibold text-ink truncate"><%= p.donorId.name %></div>
                        <div class="text-[11.5px] text-[#6B7280]">pledged <%= moment(p.createdAt).fromNow() %></div>
                    </div>
                    <% if (p.donorId.bloodGroup) { %><%- include('../partials/bloodBadge', { group: p.donorId.bloodGroup, size: 'sm' }) %><% } %>
                </div>
            <% }); } %>
        </div>

        <!-- Privacy -->
        <div class="bg-[#FAFAFA] rounded-[14px] p-5">
            <div class="flex items-start gap-3">
                <div class="h-9 w-9 rounded-full bg-white grid place-items-center border border-[#E5E7EB] shrink-0 text-[#10B981]">
                    <%- include('../partials/icon', { name: 'shield-check', size: 14 }) %>
                </div>
                <div>
                    <div class="text-[13px] font-semibold text-ink">Your identity stays private</div>
                    <p class="text-[12px] text-[#6B7280] mt-1 leading-[1.55]">
                        The patient or their family won't see your phone number unless you choose to share it. Hospital staff get only what's needed to coordinate your donation.
                    </p>
                </div>
            </div>
        </div>
    </aside>
</div>

<!-- Sticky mobile pledge bar -->
<% if (!myPledge) { %>
    <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-[#E5E7EB] px-5 py-3 z-40">
        <form action="/donor/requests/<%= r._id %>/pledge" method="POST" class="flex items-center gap-3">
            <div class="flex-1">
                <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#9CA3AF]"><%= r.urgency %></div>
                <div class="text-[13px] font-semibold text-ink"><%= r.unitsNeeded %> units of <%= r.bloodGroup %></div>
            </div>
            <button type="submit" class="rs-btn-primary h-11 px-5 rounded-[10px] font-semibold text-[14px] flex-1">I can donate</button>
        </form>
    </div>
<% } %>

<div data-live-banner class="hidden fixed top-20 right-4 bg-ink text-white px-4 py-2 rounded-[10px] text-[13px] font-semibold z-50"></div>

<%- include('../partials/appShellEnd') %>
