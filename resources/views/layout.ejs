<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'RaktSetu — every drop counts' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
                    colors: {
                        crimson: { DEFAULT: '#C8232C', dark: '#8B1A20', soft: '#FCE9EA' },
                        ink: '#1A1A1A',
                        muted: '#6B7280',
                    },
                },
            },
        };
    </script>
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%23C8232C'/><path d='M16 6c0 0-7 8.5-7 13a7 7 0 0014 0c0-4.5-7-13-7-13z' fill='white'/></svg>" />
</head>
<body
    <%- (user && user.role === 'donor' && user.bloodGroup) ? `data-donor-group="${user.bloodGroup}" data-donor-city="${user.city || ''}"` : '' %>
>
    <% if (typeof messages !== 'undefined' && messages.success) { %>
        <div data-flash class="fixed top-4 right-4 z-50 rs-flash-success rounded-[10px] px-4 py-3 text-[13.5px] font-medium shadow-lg">
            <%= messages.success %>
        </div>
    <% } %>
    <% if (typeof messages !== 'undefined' && messages.error) { %>
        <div data-flash class="fixed top-4 right-4 z-50 rs-flash-error rounded-[10px] px-4 py-3 text-[13.5px] font-medium shadow-lg">
            <%= messages.error %>
        </div>
    <% } %>

    <%- body %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>
