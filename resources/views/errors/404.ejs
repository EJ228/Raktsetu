<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found · RaktSetu</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%23C8232C'/><path d='M16 6c0 0-7 8.5-7 13a7 7 0 0014 0c0-4.5-7-13-7-13z' fill='white'/></svg>" />
</head>
<body class="bg-[#FAFAFA] font-sans antialiased text-ink min-h-screen flex flex-col items-center justify-center p-6">
    <div class="w-full max-w-2xl bg-white rounded-[14px] border border-[#E5E7EB] p-12 md:p-16 text-center relative overflow-hidden">
        
        <!-- Concentric circles and drop -->
        <div class="relative w-48 h-48 mx-auto mb-10 flex flex-col items-center justify-center">
            <div class="absolute inset-0 rounded-full border border-[#FCE9EA] animate-[ping_3s_linear_infinite]"></div>
            <div class="absolute inset-4 rounded-full border border-[#FCE9EA]"></div>
            <div class="absolute inset-8 rounded-full border border-[#FCA5A5]/30"></div>
            <div class="absolute inset-x-0 top-1/2 h-[1px] bg-ink/80 -translate-y-1/2 z-10 w-full max-w-[120px] mx-auto"></div>
            
            <div class="relative z-20 h-16 w-16 rounded-full bg-[#C8232C] text-white grid place-items-center shadow-lg shadow-red-500/20">
                <%- include('../partials/icon', { name: 'droplet', size: 28, stroke: 2, fill: 'currentColor' }) %>
            </div>
            
            <div class="absolute bottom-4 left-0 w-full text-center text-[11px] font-mono tracking-widest text-[#9CA3AF] z-10 bg-white/80 backdrop-blur-sm py-1">
                ERR 404
            </div>
        </div>

        <div class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#9CA3AF] mb-3">
            PAGE NOT FOUND
        </div>
        
        <h1 class="font-bold text-ink tracking-tight mb-4" style="font-size: 40px; letter-spacing: -0.02em; line-height: 1.1;">
            This bridge doesn't reach.
        </h1>
        
        <p class="text-[15px] text-[#6B7280] leading-relaxed max-w-md mx-auto mb-10">
            The page you were looking for has been moved, deleted, or never existed. The donors are still here — let's get you back to them.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
            <a href="/" class="rs-btn-primary h-11 px-6 rounded-[10px] font-semibold text-[14px] inline-flex items-center gap-2.5 w-full sm:w-auto justify-center transition-transform active:scale-95">
                <%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %>
                Back to home
            </a>
            <a href="/search" class="h-11 px-6 rounded-[10px] bg-white border border-[#E5E7EB] text-ink font-semibold text-[14px] inline-flex items-center gap-2.5 w-full sm:w-auto justify-center hover:bg-[#FAFAFA] transition-colors active:scale-95 shadow-sm">
                <%- include('../partials/icon', { name: 'search', size: 16, stroke: 2 }) %>
                Find a blood bank
            </a>
        </div>

        <a href="mailto:support@raktsetu.in" class="inline-flex items-center gap-2 text-[13px] font-semibold text-ink hover:text-[#C8232C] transition-colors">
            <%- include('../partials/icon', { name: 'mail', size: 16 }) %>
            Contact support
        </a>

        <div class="mt-16 pt-8 border-t border-[#F3F4F6] text-center text-[10px] font-mono tracking-widest text-[#D1D5DB]">
            ref · 404 / 4F666h · raktsetu.in
        </div>
    </div>
</body>
</html>
