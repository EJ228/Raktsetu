                    <li><a href="#" class="hover:text-ink">Help center</a></li>
                    <li><a href="#" class="hover:text-ink">Eligibility guide</a></li>
                    <li><a href="#" class="hover:text-ink">Blood facts</a></li>
                    <li><a href="#" class="hover:text-ink">Compatibility chart</a></li>
                </ul>
            </div>
            <!-- Legal -->
            <div>
                <h4 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6B7280] mb-4">Legal</h4>
                <ul class="flex flex-col gap-2.5 text-[13px] text-[#6B7280]">
                    <li><a href="#" class="hover:text-ink">Privacy</a></li>
