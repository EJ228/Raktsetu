<%- include('../partials/appShellStart', { active: 'my', shellTitle: 'My requests', shellSubtitle: 'Requester' }) %>

<div class="grid gap-6">

    <!-- KPI strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../partials/kpiCard', { icon: 'activity',     value: counts.active.toString(),     label: 'Active requests',  subLabel: 'In progress right now', tone: 'info' }) %>
        <%- include('../partials/kpiCard', { icon: 'check-circle', value: counts.fulfilled.toString(),  label: 'Fulfilled',         subLabel: 'Lifetime', tone: 'success' }) %>
        <%- include('../partials/kpiCard', { icon: 'users',        value: requests.reduce(function(a,r){return a + (r.pledges || 0);}, 0).toString(), label: 'Donors who pledged', subLabel: 'Across all requests' }) %>
        <%- include('../partials/kpiCard', { icon: 'droplet',      value: requests.reduce(function(a,r){return a + r.unitsFulfilled;}, 0).toString(), label: 'Units received',    subLabel: '≈ ' + (requests.reduce(function(a,r){return a + r.unitsFulfilled;}, 0) * 450) + ' ml' }) %>
    </div>

    <!-- List card -->
    <div class="bg-white rounded-[14px] border border-[#E5E7EB] p-4 md:p-6">
        <!-- Tabs + new request button -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <div class="flex gap-1 border-b border-[#E5E7EB] flex-1">
                <% [
                    { id: 'all',       label: 'All',        count: counts.all },
                    { id: 'active',    label: 'Active',     count: counts.active },
                    { id: 'fulfilled', label: 'Fulfilled',  count: counts.fulfilled },
                    { id: 'cancelled', label: 'Cancelled',  count: counts.cancelled },
                ].forEach(function(t){ var on = (tab === t.id); %>
                    <a href="/requester/my?tab=<%= t.id %>" class="h-10 px-4 inline-flex items-center gap-2 text-[13px] font-semibold border-b-2 -mb-px"
                       style="color:<%= on ? '#1A1A1A' : '#6B7280' %>;border-color:<%= on ? '#C8232C' : 'transparent' %>;">
                        <%= t.label %>
                        <span class="text-[10.5px] font-bold rounded-full px-1.5 min-w-[20px] h-5 grid place-items-center tabular-nums" style="background:<%= on ? '#FCE9EA' : '#F3F4F6' %>;color:<%= on ? '#C8232C' : '#6B7280' %>;">
                            <%= t.count %>
                        </span>
                    </a>
                <% }); %>
            </div>
            <a href="/requester/new" class="rs-btn-primary h-10 px-4 rounded-[10px] font-semibold text-[13px] inline-flex items-center gap-2">
                <%- include('../partials/icon', { name: 'plus', size: 14 }) %>
                New request
            </a>
        </div>

        <% if (requests.length === 0) { %>
            <div class="py-4">
                <%- include('../partials/emptyState', {
                    context: 'REQUESTER · MY REQUESTS',
                    icon: 'heart',
                    tone: 'red',
                    title: "You haven't posted any requests yet",
                    desc: "Need blood for yourself or a loved one? Post a request and we'll notify compatible donors and reserve units at a nearby bank within minutes.",
                    primaryBtn: { text: 'Create your first request', href: '/requester/new', icon: 'plus' },
                    secondaryBtn: { text: 'How it works', href: '#' }
                }) %>
            </div>
        <% } else { %>
            <div class="grid gap-3">
                <% requests.forEach(function(r) { var pct = Math.round((r.unitsFulfilled / r.unitsNeeded) * 100); %>
                    <a href="/requester/requests/<%= r._id %>" class="block bg-white rounded-[14px] border border-[#E5E7EB] p-5 hover:border-ink/25 transition-colors">
                        <div class="flex items-start gap-6">
                            <div class="shrink-0">
                                <%- include('../partials/bloodBadge', { group: r.bloodGroup, size: 'lg' }) %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                                    <%- include('../partials/statusBadge', { status: r.status }) %>
                                    <%- include('../partials/urgencyBadge', { level: r.urgency }) %>
                                    <span class="text-[11px] font-mono text-[#9CA3AF]">#RS-<%= String(r._id).slice(-5).toUpperCase() %></span>
                                </div>
                                <h3 class="text-[16px] font-semibold text-ink tracking-tight">
                                    <%= r.unitsNeeded %> units of <%= r.bloodGroup %> for <%= r.patientName %>, <%= r.patientAge %>
                                </h3>
                                <div class="mt-3 grid md:grid-cols-2 gap-x-6 gap-y-2 text-[12.5px] text-[#6B7280]">
                                    <div class="flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'hospital', size: 12 }) %>
                                        <span class="truncate"><%= r.bloodBankId ? r.bloodBankId.name : 'Bank' %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'clock', size: 12 }) %>
                                        Needed by <%= moment(r.neededBy).format('DD MMM, h:mm A') %>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'users', size: 12 }) %>
                                        <%= r.pledges %> donor<%= r.pledges === 1 ? '' : 's' %> pledged
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'calendar', size: 12 }) %>
                                        Posted <%= moment(r.createdAt).fromNow() %>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <div class="flex items-center justify-between text-[11.5px] mb-1.5">
                                        <span class="font-semibold text-ink tabular-nums"><%= r.unitsFulfilled %> of <%= r.unitsNeeded %> units secured</span>
                                        <span class="text-[#6B7280]"><%= pct %>%</span>
                                    </div>
                                    <div class="h-2 rounded-full bg-[#F3F4F6] overflow-hidden">
                                        <div class="h-full rounded-full" style="width:<%= pct %>%;background:<%= r.status === 'fulfilled' ? '#10B981' : '#C8232C' %>;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/appShellEnd') %>
