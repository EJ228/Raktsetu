<%- include('../partials/appShellStart', { active: 'requests', shellTitle: 'Request management', shellSubtitle: 'GMC Blood Bank · Incoming queue' }) %>

<div class="bg-white rounded-[14px] border border-[#E5E7EB]" data-bank-id="<%= user.bloodBankId %>">

    <!-- Tabs -->
    <div class="flex gap-1 px-4 md:px-6 border-b border-[#E5E7EB]">
        <% [
            { id: 'pending',   label: 'New',        count: counts.pending },
            { id: 'progress',  label: 'Active',     count: counts.progress },
            { id: 'fulfilled', label: 'Fulfilled',  count: counts.fulfilled },
        ].forEach(function(t){ var on = (tab === t.id); %>
            <a href="/bank/requests?tab=<%= t.id %>" class="h-11 px-4 inline-flex items-center gap-2 text-[13px] font-semibold border-b-2 -mb-px"
               style="color:<%= on ? '#1A1A1A' : '#6B7280' %>;border-color:<%= on ? '#C8232C' : 'transparent' %>;">
                <%= t.label %>
                <span class="text-[10.5px] font-bold rounded-full px-1.5 min-w-[20px] h-5 grid place-items-center tabular-nums" style="background:<%= on ? '#FCE9EA' : '#F3F4F6' %>;color:<%= on ? '#C8232C' : '#6B7280' %>;">
                    <%= t.count %>
                </span>
            </a>
        <% }); %>
    </div>

    <% if (requests.length === 0) { %>
        <div class="py-16 text-center">
            <div class="mx-auto h-14 w-14 rounded-full bg-[#D1FAE5] grid place-items-center text-[#065F46] mb-3">
                <%- include('../partials/icon', { name: 'check-circle', size: 22 }) %>
            </div>
            <h3 class="font-semibold text-ink text-[18px]">No requests in this tab</h3>
            <p class="text-[13px] text-[#6B7280] mt-1">All clear for now.</p>
        </div>
    <% } else { %>
        <div class="divide-y divide-[#E5E7EB]">
            <% requests.forEach(function(r){ %>
                <div class="p-5 md:p-6 hover:bg-[#FAFAFA]/50 transition-colors">
                    <div class="flex flex-wrap items-start gap-5">
                        <!-- Blood badge + info -->
                        <div class="flex items-start gap-4 flex-1 min-w-[300px]">
                            <%- include('../partials/bloodBadge', { group: r.bloodGroup, size: 'lg' }) %>
                            <div class="flex-1">
                                <div class="flex items-center gap-2 flex-wrap mb-1">
                                    <%- include('../partials/statusBadge', { status: r.status }) %>
                                    <%- include('../partials/urgencyBadge', { level: r.urgency }) %>
                                    <span class="text-[11px] font-mono text-[#9CA3AF]">#RS-<%= String(r._id).slice(-5).toUpperCase() %></span>
                                </div>
                                <h3 class="font-semibold text-ink text-[15px] leading-snug">
                                    <%= r.unitsNeeded %> units · <%= r.component ? r.component.replace('_', ' ') : 'Whole Blood' %> for <%= r.patientName %>, <%= r.patientAge %>
                                </h3>
                                <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[12px] text-[#6B7280]">
                                    <span class="inline-flex items-center gap-1">
                                        <%- include('../partials/icon', { name: 'clock', size: 11 }) %>
                                        Needed by <%= moment(r.neededBy).format('ddd, h:mm A') %>
                                    </span>
                                    <span class="inline-flex items-center gap-1">
                                        <%- include('../partials/icon', { name: 'calendar', size: 11 }) %>
                                        <%= moment(r.createdAt).fromNow() %>
                                    </span>
                                    <span class="inline-flex items-center gap-1">
                                        <%- include('../partials/icon', { name: 'users', size: 11 }) %>
                                        <%= r.pledges %> pledged
                                    </span>
                                </div>

                                <!-- Patient details -->
                                <div class="mt-3 grid grid-cols-2 gap-x-8 gap-y-1.5 text-[12px]">
                                    <div><span class="text-[#9CA3AF] uppercase text-[10px] tracking-wide font-semibold">Patient</span>
                                        <div class="text-ink font-medium"><%= r.patientName %> · <%= r.patientAge %><%= r.patientGender === 'male' ? 'M' : r.patientGender === 'female' ? 'F' : '' %></div>
                                    </div>
                                    <div><span class="text-[#9CA3AF] uppercase text-[10px] tracking-wide font-semibold">Indication</span>
                                        <div class="text-ink font-medium"><%= r.condition || '—' %></div>
                                    </div>
                                    <div><span class="text-[#9CA3AF] uppercase text-[10px] tracking-wide font-semibold">Requester</span>
                                        <div class="text-ink font-medium"><%= r.requesterId.name %></div>
                                    </div>
                                    <div><span class="text-[#9CA3AF] uppercase text-[10px] tracking-wide font-semibold">Contact</span>
                                        <div class="text-ink font-medium"><%= r.phone || '—' %></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="shrink-0 flex flex-col gap-2 items-end">
                            <% if (r.status === 'pending' || r.status === 'matched') { %>
                                <form action="/bank/requests/status" method="POST" class="flex gap-2">
                                    <input type="hidden" name="requestId" value="<%= r._id %>" />
                                    <button type="submit" name="status" value="assigned" class="rs-btn-primary h-10 px-5 rounded-[10px] font-semibold text-[13px] inline-flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'check-circle', size: 14 }) %> Accept request
                                    </button>
                                </form>
                                <form action="/bank/requests/status" method="POST">
                                    <input type="hidden" name="requestId" value="<%= r._id %>" />
                                    <button type="submit" name="status" value="cancelled" class="h-10 px-5 rounded-[10px] border border-[#E5E7EB] text-[#6B7280] font-semibold text-[13px] inline-flex items-center gap-1.5 hover:bg-[#FAFAFA]">
                                        <%- include('../partials/icon', { name: 'x', size: 14 }) %> Decline
                                    </button>
                                </form>
                            <% } else if (r.status === 'assigned') { %>
                                <form action="/bank/requests/status" method="POST">
                                    <input type="hidden" name="requestId" value="<%= r._id %>" />
                                    <button type="submit" name="status" value="fulfilled" class="h-10 px-5 rounded-[10px] bg-[#10B981] text-white font-semibold text-[13px] inline-flex items-center gap-1.5">
                                        <%- include('../partials/icon', { name: 'check-circle', size: 14 }) %> Mark fulfilled
                                    </button>
                                </form>
                            <% } else { %>
                                <span class="text-[12px] text-[#6B7280] italic">Completed</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Progress bar -->
                    <% if (r.status !== 'fulfilled' && r.status !== 'cancelled') {
                        var pct = Math.round((r.unitsFulfilled || 0) / r.unitsNeeded * 100);
                    %>
                        <div class="mt-4 flex items-center gap-3">
                            <span class="text-[12px] text-[#6B7280]"><%= r.unitsFulfilled || 0 %> of <%= r.unitsNeeded %> units secured</span>
                            <div class="flex-1 h-2 rounded-full bg-[#F3F4F6]">
                                <div class="h-full rounded-full bg-[#10B981]" style="width:<%= pct %>%;"></div>
                            </div>
                            <span class="text-[12px] font-semibold text-ink tabular-nums"><%= pct %>%</span>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('../partials/appShellEnd') %>
