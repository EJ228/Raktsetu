<%
    var s = (typeof size !== 'undefined') ? size : 36;
    var parts = String(name || '?').split(' ').filter(Boolean);
    var initials = parts.length === 0 ? '?' : (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
    var h = 0;
    for (var i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 360;
%>
<span class="inline-grid place-items-center rounded-full font-semibold tracking-tight shrink-0" style="width:<%= s %>px;height:<%= s %>px;background:oklch(0.94 0.03 <%= h %>);color:oklch(0.35 0.06 <%= h %>);font-size:<%= s * 0.36 %>px;">
    <%= initials %>
</span>
